        "options": {}
      },
      "id": "list-files-prepare",
      "name": "List Files - Prepare",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1500, -400]
    },
    {
      "parameters": {
        "jsCode": "// Convert glob pattern to GitHub search query\nconst pattern = $input.item.json.pattern;\nconst owner = $input.item.json.owner;\nconst repo = $input.item.json.repo;\n\nlet searchQuery = '';\n\n// Extract directory path from glob pattern\n// e.g., \"src/**/*.css\" -> \"path:src\"\nconst pathMatch = pattern.match(/^([^*]+)/);\nif (pathMatch && pathMatch[1]) {\n  const cleanPath = pathMatch[1].replace(/\\/$/, '');\n  if (cleanPath) {\n    searchQuery += `path:${cleanPath}`;\n  }\n}\n\n// Extract file extension from glob pattern\n// e.g., \"**/*.css\" -> \"extension:css\"\nconst extMatch = pattern.match(/\\*\\.(\\w+)$/);\nif (extMatch) {\n  if (searchQuery) searchQuery += '+';\n  searchQuery += `extension:${extMatch[1]}`;\n}\n\n// If no specific pattern, just search repo\nif (!searchQuery) {\n  searchQuery = 'path:/';\n}\n\n// Build full query\nconst query = `repo:${owner}/${repo}+${searchQuery}`;\n\nreturn {\n  json: {\n    query: query,\n    url: 'https://api.github.com/search/code',\n    method: 'GET',\n    originalPattern: pattern\n  }\n};"
      },
      "id": "list-files-build-query",
      "name": "List Files - Build Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1700, -400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.query }}"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "list-files-api-call",
      "name": "List Files - API Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1900, -400]
    },
    {
      "parameters": {
        "jsCode": "// Format file list for AI\nconst response = $input.item.json;\nconst originalPattern = $('List Files - Build Query').item.json.originalPattern;\n\nif (!response || !response.items) {\n  return {\n    json: {\n      success: true,\n      files: [],\n      message: `No files matching pattern '${originalPattern}'`\n    }\n  };\n}\n\nconst files = response.items.map(item => ({\n  path: item.path,\n  name: item.name,\n  size: item.size || 0,\n  url: item.html_url\n}));\n\nreturn {\n  json: {\n    success: true,\n    files: files,\n    total: files.length,\n    pattern: originalPattern,\n    message: `Found ${files.length} files matching '${originalPattern}'`\n  }\n};"
      },
      "id": "list-files-format",
      "name": "List Files - Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2100, -400]
    }
