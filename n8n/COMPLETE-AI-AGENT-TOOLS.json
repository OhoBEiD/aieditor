      "id": "search-code-prepare",
      "name": "Search Code - Prepare",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1500, -800]
    },
    {
      "parameters": {
        "jsCode": "// Build GitHub search query\nconst pattern = $input.item.json.pattern;\nconst fileTypes = $input.item.json.fileTypes || [];\nconst owner = $input.item.json.owner;\nconst repo = $input.item.json.repo;\n\n// Add file type filters if provided\nlet fileExtension = '';\nif (fileTypes.length > 0) {\n  fileExtension = fileTypes.map(t => `+extension:${t}`).join('');\n}\n\n// Build query: pattern + repo + file extensions\nconst query = `${pattern}+repo:${owner}/${repo}${fileExtension}`;\n\nreturn {\n  json: {\n    query: query,\n    url: 'https://api.github.com/search/code',\n    method: 'GET'\n  }\n};"
      },
      "id": "search-code-build-query",
      "name": "Search Code - Build Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1700, -800]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.query }}"
            },
            {
              "name": "per_page",
              "value": "50"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "search-code-api-call",
      "name": "Search Code - API Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1900, -800]
    },
    {
      "parameters": {
        "jsCode": "// Format search results for AI\nconst response = $input.item.json;\n\nif (!response || !response.items) {\n  return {\n    json: {\n      success: true,\n      matches: [],\n      message: 'No matches found'\n    }\n  };\n}\n\nconst matches = response.items.map(item => ({\n  path: item.path,\n  repository: item.repository?.full_name || 'unknown',\n  score: item.score,\n  url: item.html_url\n}));\n\nreturn {\n  json: {\n    success: true,\n    matches: matches,\n    total: response.total_count || 0,\n    message: `Found ${matches.length} matches across ${matches.length} files`\n  }\n};"
      },
      "id": "search-code-format",
      "name": "Search Code - Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2100, -800]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "filePath",
              "name": "filePath",
              "value": "={{ $json.filePath }}",
              "type": "string"
            },
            {
              "id": "owner",
              "name": "owner",
              "value": "={{ $('Merge Files').item.json.site.owner }}",
              "type": "string"
            },
            {
              "id": "repo",
              "name": "repo",
              "value": "={{ $('Merge Files').item.json.site.repo }}",
              "type": "string"
            },
            {
              "id": "branch",
              "name": "branch",
              "value": "={{ $('Merge Files').item.json.site.default_branch || 'main' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "read-file-prepare",
      "name": "Read File - Prepare",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1500, -600]
    },
    {
      "parameters": {
        "jsCode": "// Build GitHub file content URL\nconst filePath = $input.item.json.filePath;\nconst owner = $input.item.json.owner;\nconst repo = $input.item.json.repo;\nconst branch = $input.item.json.branch;\n\nconst url = `https://api.github.com/repos/${owner}/${repo}/contents/${filePath}?ref=${branch}`;\n\nreturn {\n  json: {\n    url: url,\n    filePath: filePath\n  }\n};"
      },
      "id": "read-file-build-url",
      "name": "Read File - Build URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1700, -600]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.raw"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "read-file-api-call",
      "name": "Read File - API Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1900, -600]
    },
    {
      "parameters": {
        "jsCode": "// Format file contents for AI\nconst content = $input.item.json;\nconst filePath = $('Read File - Build URL').item.json.filePath;\n\n// Add line numbers to content\nlet numberedContent = '';\nif (typeof content === 'string') {\n  const lines = content.split('\\n');\n  numberedContent = lines.map((line, i) => `${i + 1}\\t${line}`).join('\\n');\n} else {\n  numberedContent = 'Error: Could not read file';\n}\n\nreturn {\n  json: {\n    success: true,\n    filePath: filePath,\n    content: numberedContent,\n    lines: typeof content === 'string' ? content.split('\\n').length : 0,\n    message: `Successfully read ${filePath} (${typeof content === 'string' ? content.split('\\n').length : 0} lines)`\n  }\n};"
      },
      "id": "read-file-format",
      "name": "Read File - Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2100, -600]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "pattern",
              "name": "pattern",
              "value": "={{ $json.pattern }}",
              "type": "string"
            },
            {
              "id": "owner",
              "name": "owner",
              "value": "={{ $('Merge Files').item.json.site.owner }}",
              "type": "string"
            },
            {
              "id": "repo",
              "name": "repo",
              "value": "={{ $('Merge Files').item.json.site.repo }}",
              "type": "string"
            }
          ]
