# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Model Provider (OpenRouter — routes to Gemini, Claude, etc.)
OPENROUTER_API_KEY=your-openrouter-api-key

# Web Search (Serper.dev — Google Search API)
SERPER_API_KEY=your-serper-api-key

# AI Image Generation (Replicate — Flux Schnell)
# Get your API token from: https://replicate.com/account/api-tokens
# Cost: ~$0.003 per image (very cheap!)
# Free tier: 50 generations/month via free trial
REPLICATE_API_TOKEN=your-replicate-api-token

# GitHub (for repo operations)
GITHUB_TOKEN=your-github-token

# Vercel Deployment
VERCEL_TOKEN=your-vercel-token
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id

# n8n Webhook URLs (optional — for workflow automation)
N8N_WEBHOOK_EDIT_UI=https://your-n8n.app.n8n.cloud/webhook/agent/edit-ui
N8N_WEBHOOK_APPLY=https://your-n8n.app.n8n.cloud/webhook/agent/apply
N8N_WEBHOOK_ROLLBACK=https://your-n8n.app.n8n.cloud/webhook/agent/rollback
N8N_WEBHOOK_PREVIEW=https://your-n8n.app.n8n.cloud/webhook/preview/deploy
N8N_WEBHOOK_DEPLOY=https://your-n8n.app.n8n.cloud/webhook/agent/deploy
